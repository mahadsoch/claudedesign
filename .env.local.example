# Copy to .env.local and fill in to enable "Generate with AI".
# Get a key at https://console.anthropic.com/ — it stays server-side (never shipped to the browser).
ANTHROPIC_API_KEY=

# Optional: override the Chromium binary used for PDF export.
# Defaults to /opt/pw-browsers/chromium, else Playwright's bundled browser.
# PLAYWRIGHT_CHROMIUM_PATH=
